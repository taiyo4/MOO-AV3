%% =====================================================================
%% SEQ-004 - Lista de espera e oferta de vaga (UC-034 a UC-036) - FASE 6
%% PROPOSTA DO INTEGRANTE 2 (casos de uso e diagramas comportamentais).
%% Natureza: PROPOSTA. Nao substitui artefato oficial do grupo.
%% Fonte da verdade do CONTEUDO.
%%
%% Regras da DEC-027 (vigentes):
%%   1. fila por ORDEM DE ENTRADA (sem prioridade manual);
%%   2. UMA oferta aberta por vez por psicologo;
%%   3. a oferta tem PRAZO DE ACEITE;
%%   4. recusa (ou vencimento) PASSA A OFERTA AO PROXIMO.
%%
%% Rastreabilidade das mensagens (alinhada ao CLS-001 - P10 / Q5-09):
%%   AP-06 ServicoListaEspera: entrarNaFila | consultarPosicao | sairDaFila |
%%        ofertarVaga | aceitarOferta | recusarOferta |
%%        proximoDaFila (consulta da colecao - decisao P10, nao e operacao da
%%        instancia SolicitacaoEspera)
%%   AP-03 ServicoAgenda.agendar | AP-02 ServicoAuditoria.registrar
%%   AP-04 ServicoEnvioMensagem.notificar
%%   OP-23 SolicitacaoEspera.registrarEntrada(psicologo, paciente, horario,
%%        solicitante) | OP-25 abrirOferta(horario, prazoAceite)
%%   OP-26 validarPrazo() - decisao P10: mantida como operacao de consulta da
%%        classe (o atributo prazoAceite ja existe); encaminhada ao I3 no CLS-001
%%   OP-27 aceitar(solicitante) | recusar(solicitante) | expirar() |
%%        encerrar(motivo, solicitante) | OP-28 consultarPosicao() Inteiro
%%   Agendamento.solicitar (cria JA CONFIRMADO)
%%   Falha de envio: registrar("FALHA_ENVIO_EMAIL") e repetivel (DEC-029)
%% Regras: RN-003, RN-005, RN-009, RN-010, RN-013
%% Requisitos: RF-025, RF-026, RF-027, RF-032, RF-033, RF-034, RF-035, RF-036
%% Casos: UC-034, UC-035 (<<extend>> de UC-027), UC-036
%% =====================================================================
%% label: SEQ-004 - Lista de espera e oferta de vaga (UC-034 a UC-036)
%% sub: Fonte editavel: 03-uml/Sequencias/proposta-I2-sequencia-seq-004-lista-espera.mmd | PROPOSTA do Integrante 2 (Fase 6) | alinhada ao CLS-001 (P10/Q5-09) | DEC-027: fila por ordem de entrada, uma oferta por vez, prazo de aceite com horario reservado, recusa passa ao proximo

sequenceDiagram
    actor Ator as Ator (Paciente)
    participant ServicoListaEspera as ServicoListaEspera
    participant SolicitacaoEspera as SolicitacaoEspera
    participant ServicoAgenda as ServicoAgenda
    participant Agendamento as Agendamento
    participant ServicoAuditoria as ServicoAuditoria
    participant RegistroAuditoria as RegistroAuditoria
    participant ServicoEnvioMensagem as ServicoEnvioMensagem

    Ator->>ServicoListaEspera: entrarNaFila(psicologo, paciente, horario) [RF-034 / UC-034]
    ServicoListaEspera->>SolicitacaoEspera: registrarEntrada(psicologo, paciente, horario, solicitante) [OP-23]
    SolicitacaoEspera-->>ServicoListaEspera: solicitacao (AGUARDANDO, dataHoraEntrada)
    ServicoListaEspera->>ServicoAuditoria: registrar("ESPERA_REGISTRADA", responsavel, detalhes) [AP-02]
    ServicoAuditoria->>RegistroAuditoria: registrar(responsavel, data, hora, operacao) [RF-032]
    ServicoListaEspera-->>Ator: posicao na fila (ordem de entrada)

    opt Consulta de posicao e saida da fila [RF-034 / DEC-027]
        Ator->>ServicoListaEspera: consultarPosicao(psicologo, paciente) [AP-06]
        ServicoListaEspera->>SolicitacaoEspera: consultarPosicao() [OP-28]
        SolicitacaoEspera-->>ServicoListaEspera: posicao e dataHoraEntrada
        ServicoListaEspera-->>Ator: posicao atual na fila e estimativa pela ordem de entrada
        Ator->>ServicoListaEspera: sairDaFila(solicitacao) [AP-06 / DEC-027]
        ServicoListaEspera->>SolicitacaoEspera: encerrar("DESISTIU", solicitante) [OP-27]
        SolicitacaoEspera-->>ServicoListaEspera: solicitacao (DESISTIU)
        ServicoListaEspera->>ServicoAuditoria: registrar("ESPERA_ENCERRADA", responsavel, detalhes) [AP-02]
        ServicoAuditoria->>RegistroAuditoria: registrar(responsavel, data, hora, operacao) [RF-032]
        ServicoListaEspera-->>Ator: entrada encerrada - a posicao deixa de existir
    end

    opt <<extend>> do cancelamento - horario liberado [RF-035 / UC-035]
        ServicoAgenda->>ServicoListaEspera: ofertarVaga(horarioLiberado) [AP-06 / DEC-027]
        ServicoListaEspera->>SolicitacaoEspera: proximoDaFila(psicologo) [AP-06 - consulta da colecao / P10]
        SolicitacaoEspera-->>ServicoListaEspera: solicitacao mais antiga (AGUARDANDO)
        alt Ha solicitacao na fila e nenhuma oferta aberta
            ServicoListaEspera->>SolicitacaoEspera: abrirOferta(horario, prazoAceite) [OP-25 - uma oferta por vez]
            SolicitacaoEspera-->>ServicoListaEspera: solicitacao (OFERTADA) - horario reservado ate o prazo
            ServicoListaEspera->>ServicoEnvioMensagem: notificar(evento=ofertaVaga) [AP-04 / RF-033]
            alt Envio aceito pelo servico externo
                ServicoEnvioMensagem-->>ServicoListaEspera: entregue
            else Falha de envio - nao desfaz a oferta [DEC-029]
                ServicoEnvioMensagem-->>ServicoListaEspera: falha de envio
                ServicoListaEspera->>ServicoAuditoria: registrar("FALHA_ENVIO_EMAIL", responsavel, detalhes) [AP-02]
                ServicoAuditoria->>RegistroAuditoria: registrar(responsavel, data, hora, operacao) [RF-032]
            end
            ServicoListaEspera->>ServicoAuditoria: registrar("OFERTA_VAGA_ABERTA", responsavel, detalhes) [AP-02]
            ServicoAuditoria->>RegistroAuditoria: registrar(responsavel, data, hora, operacao) [RF-032]
        else Fila vazia ou oferta ja aberta
            ServicoListaEspera-->>ServicoAgenda: nenhuma oferta aberta - horario permanece no catalogo
        end
    end

    alt Aceite dentro do prazo de aceite [RF-036]
        Ator->>ServicoListaEspera: aceitarOferta(solicitacao)
        ServicoListaEspera->>SolicitacaoEspera: validarPrazo() [OP-26 / P10]
        SolicitacaoEspera-->>ServicoListaEspera: true - oferta ainda valida
        ServicoListaEspera->>ServicoAgenda: agendar(psicologo, paciente, horario) [RF-025]
        ServicoAgenda->>Agendamento: solicitar(psicologo, paciente, horario, solicitante) [RF-025]
        Agendamento-->>ServicoAgenda: agendamento (CONFIRMADO) [RF-026 / RN-013]
        ServicoAgenda->>ServicoAuditoria: registrar("AGENDAMENTO_CONFIRMADO", responsavel, detalhes) [AP-02]
        ServicoAuditoria->>RegistroAuditoria: registrar(responsavel, data, hora, operacao) [RF-032]
        ServicoAgenda->>ServicoEnvioMensagem: notificar(evento=confirmacao) [AP-04 / RF-033]
        alt Envio aceito pelo servico externo
            ServicoEnvioMensagem-->>ServicoAgenda: entregue
        else Falha de envio - nao desfaz o aceite [DEC-029]
            ServicoEnvioMensagem-->>ServicoAgenda: falha de envio
            ServicoAgenda->>ServicoAuditoria: registrar("FALHA_ENVIO_EMAIL", responsavel, detalhes) [AP-02]
            ServicoAuditoria->>RegistroAuditoria: registrar(responsavel, data, hora, operacao) [RF-032]
        end
        ServicoListaEspera->>SolicitacaoEspera: aceitar(solicitante) [OP-27 - valida prazoAceite]
        ServicoListaEspera-->>Ator: vaga confirmada (ACEITA, UC-036)
    else Recusa
        Ator->>ServicoListaEspera: recusarOferta(solicitacao)
        ServicoListaEspera->>SolicitacaoEspera: recusar(solicitante) [OP-27]
        ServicoListaEspera->>ServicoAuditoria: registrar("OFERTA_RECUSADA", responsavel, detalhes) [AP-02]
        ServicoListaEspera->>ServicoListaEspera: ofertarVaga(horarioLiberado) - passa ao proximo da fila [DEC-027]
    else Prazo de aceite vencido
        ServicoListaEspera->>SolicitacaoEspera: expirar() [OP-27 - encerra como EXPIRADA]
        SolicitacaoEspera-->>ServicoListaEspera: solicitacao (EXPIRADA)
        ServicoListaEspera->>ServicoAuditoria: registrar("OFERTA_EXPIRADA", responsavel, detalhes) [AP-02]
        ServicoListaEspera->>ServicoListaEspera: ofertarVaga(horarioLiberado) - passa ao proximo da fila [DEC-027]
    end

    note over Ator,ServicoListaEspera: A fila e estritamente por dataHoraEntrada: nao ha prioridade manual nem reordenacao. Uma unica oferta fica aberta por psicologo; enquanto ela existir, a fila nao e percorrida. O paciente pode consultar a propria posicao e sair da fila a qualquer momento (DESISTIU).
    note over SolicitacaoEspera,ServicoAgenda: Enquanto a oferta esta aberta o horario fica RESERVADO e nao aparece como livre. Se a recusa ou o vencimento acontecerem sem proximo na fila, o horario volta a ficar livre no catalogo.
    note over ServicoEnvioMensagem,RegistroAuditoria: O e-mail e sempre solicitado na abertura da oferta e no aceite (RF-033); falha de envio nao desfaz a oferta nem o agendamento, e registrada na auditoria ("FALHA_ENVIO_EMAIL") e pode ser repetida (DEC-029). Aceite, recusa, vencimento e desistencia sao auditados (RN-009).
