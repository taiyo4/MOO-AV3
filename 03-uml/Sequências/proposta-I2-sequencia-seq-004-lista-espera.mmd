%% =====================================================================
%% SEQ-004 - Lista de espera e oferta de vaga (UC-034 a UC-036) - FASE 6
%% PROPOSTA DO INTEGRANTE 2 (casos de uso e diagramas comportamentais).
%% Natureza: PROPOSTA. Nao substitui artefato oficial do grupo.
%% Fonte da verdade do CONTEUDO.
%%
%% Regras da DEC-027 (vigentes):
%%   1. fila por ORDEM DE ENTRADA (sem prioridade manual);
%%   2. UMA oferta aberta por vez por psicologo;
%%   3. a oferta tem PRAZO DE ACEITE;
%%   4. recusa (ou vencimento) PASSA A OFERTA AO PROXIMO.
%%
%% Rastreabilidade das mensagens:
%%   AP-06 ServicoListaEspera: entrarNaFila | ofertarVaga | aceitarOferta |
%%        recusarOferta | expirarOferta
%%   AP-03 ServicoAgenda.agendar | AP-02 ServicoAuditoria.registrar
%%   AP-04 ServicoEnvioMensagem.notificar
%%   OP-23 SolicitacaoEspera.registrarEntrada | OP-24 proximoDaFila
%%   OP-25 abrirOferta | OP-26 validarPrazo | OP-27 encerrar
%%   Agendamento.solicitar (cria JA CONFIRMADO)
%% Regras: RN-003, RN-005, RN-009, RN-010, RN-013
%% Requisitos: RF-025, RF-026, RF-027, RF-032, RF-033, RF-034, RF-035, RF-036
%% Casos: UC-034, UC-035 (<<extend>> de UC-027), UC-036
%% =====================================================================
%% label: SEQ-004 - Lista de espera e oferta de vaga (UC-034 a UC-036)
%% sub: Fonte editavel: 03-uml/Sequencias/proposta-I2-sequencia-seq-004-lista-espera.mmd | PROPOSTA do Integrante 2 (Fase 6) | DEC-027: fila por ordem de entrada, uma oferta por vez, prazo de aceite, recusa passa ao proximo

sequenceDiagram
    actor Ator as Ator (Paciente)
    participant ServicoListaEspera as ServicoListaEspera
    participant SolicitacaoEspera as SolicitacaoEspera
    participant ServicoAgenda as ServicoAgenda
    participant Agendamento as Agendamento
    participant ServicoAuditoria as ServicoAuditoria
    participant RegistroAuditoria as RegistroAuditoria
    participant ServicoEnvioMensagem as ServicoEnvioMensagem

    Ator->>ServicoListaEspera: entrarNaFila(psicologo, paciente, periodo) [RF-034 / UC-034]
    ServicoListaEspera->>SolicitacaoEspera: registrarEntrada(psicologo, paciente, periodo) [OP-23]
    SolicitacaoEspera-->>ServicoListaEspera: solicitacao (AGUARDANDO, dataHoraEntrada)
    ServicoListaEspera->>ServicoAuditoria: registrar("ESPERA_REGISTRADA", responsavel, detalhes) [AP-02]
    ServicoAuditoria->>RegistroAuditoria: registrar(responsavel, data, hora, operacao) [RF-032]
    ServicoListaEspera-->>Ator: posicao na fila (ordem de entrada)

    opt <<extend>> do cancelamento - horario liberado [RF-035 / UC-035]
        ServicoAgenda->>ServicoListaEspera: ofertarVaga(horarioLiberado) [AP-06 / DEC-027]
        ServicoListaEspera->>SolicitacaoEspera: proximoDaFila(psicologo) [OP-24 - ordem de entrada]
        SolicitacaoEspera-->>ServicoListaEspera: solicitacao mais antiga (AGUARDANDO)
        alt Ha solicitacao na fila e nenhuma oferta aberta
            ServicoListaEspera->>SolicitacaoEspera: abrirOferta(prazoAceite) [OP-25 - uma oferta por vez]
            SolicitacaoEspera-->>ServicoListaEspera: solicitacao (OFERTADA)
            ServicoListaEspera->>ServicoEnvioMensagem: notificar(evento=ofertaVaga) [AP-04 / RF-033]
            ServicoEnvioMensagem-->>ServicoListaEspera: entregue | falha de envio
            ServicoListaEspera->>ServicoAuditoria: registrar("OFERTA_VAGA_ABERTA", responsavel, detalhes) [AP-02]
            ServicoAuditoria->>RegistroAuditoria: registrar(responsavel, data, hora, operacao) [RF-032]
        else Fila vazia ou oferta ja aberta
            ServicoListaEspera-->>ServicoAgenda: nenhuma oferta aberta - horario permanece no catalogo
        end
    end

    alt Aceite dentro do prazo de aceite [RF-036]
        Ator->>ServicoListaEspera: aceitarOferta(solicitacao)
        ServicoListaEspera->>SolicitacaoEspera: validarPrazo() [OP-26]
        SolicitacaoEspera-->>ServicoListaEspera: true - oferta ainda valida
        ServicoListaEspera->>ServicoAgenda: agendar(psicologo, paciente, horario) [RF-025]
        ServicoAgenda->>Agendamento: solicitar(psicologo, paciente, horario, solicitante) [RF-025]
        Agendamento-->>ServicoAgenda: agendamento (CONFIRMADO) [RF-026 / RN-013]
        ServicoAgenda->>ServicoAuditoria: registrar("AGENDAMENTO_CONFIRMADO", responsavel, detalhes) [AP-02]
        ServicoAuditoria->>RegistroAuditoria: registrar(responsavel, data, hora, operacao) [RF-032]
        ServicoAgenda->>ServicoEnvioMensagem: notificar(evento=confirmacao) [AP-04 / RF-033]
        ServicoEnvioMensagem-->>ServicoAgenda: entregue | falha de envio
        ServicoListaEspera->>SolicitacaoEspera: encerrar(ACEITA) [OP-27]
        ServicoListaEspera-->>Ator: vaga confirmada (UC-036)
    else Recusa
        Ator->>ServicoListaEspera: recusarOferta(solicitacao)
        ServicoListaEspera->>SolicitacaoEspera: encerrar(RECUSADA) [OP-27]
        ServicoListaEspera->>ServicoAuditoria: registrar("OFERTA_RECUSADA", responsavel, detalhes) [AP-02]
        ServicoListaEspera->>ServicoListaEspera: ofertarVaga(horarioLiberado) - passa ao proximo da fila [DEC-027]
    else Prazo de aceite vencido
        ServicoListaEspera->>SolicitacaoEspera: expirarOferta(prazoAceite) [OP-27 - encerra como EXPIRADA]
        SolicitacaoEspera-->>ServicoListaEspera: solicitacao (EXPIRADA)
        ServicoListaEspera->>ServicoAuditoria: registrar("OFERTA_EXPIRADA", responsavel, detalhes) [AP-02]
        ServicoListaEspera->>ServicoListaEspera: ofertarVaga(horarioLiberado) - passa ao proximo da fila [DEC-027]
    end

    note over Ator,ServicoListaEspera: A fila e estritamente por dataHoraEntrada: nao ha prioridade manual nem reordenacao. Uma unica oferta fica aberta por psicologo; enquanto ela existir, a fila nao e percorrida.
    note over ServicoEnvioMensagem,RegistroAuditoria: O e-mail e sempre solicitado na abertura da oferta e no aceite (RF-033); falha de envio nao desfaz a oferta nem o agendamento. Aceite, recusa e vencimento sao auditados (RN-009).
