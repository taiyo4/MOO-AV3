%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","lineColor":"#3a414a","fontFamily":"Arial","primaryTextColor":"#202124"}}}%%
classDiagram
    direction TB
    %% Representacao adaptada de objetos: cada caixa e uma instancia, nao uma classe nova.
    %% Rotulo = nomeInstancia : Classe; membros = slots atributo = valor ilustrativo.
    %% Recorte parcial: omissao nao significa inexistencia, nulo ou zero.
    class contaProfissionalCenario["contaProfissionalCenario : Usuario"]:::acesso {
        identificacao = CONTA-FICTICIA-P01
    }
    class profissionalCenario["profissionalCenario : Psicologo"]:::cadastro
    class contaPacienteCenario["contaPacienteCenario : Usuario"]:::acesso {
        identificacao = CONTA-FICTICIA-C01
    }
    class pacienteCenario["pacienteCenario : Paciente"]:::cadastro
    class vinculoCenario["vinculoCenario : Vinculo"]:::cadastro
    class agendaCenario["agendaCenario : Agenda"]:::agenda
    class disponibilidadeCenario["disponibilidadeCenario : Disponibilidade"]:::agenda {
        periodo = SLOT-FICTICIO 2040-08-17 09h00
    }
    class agendamentoCenario["agendamentoCenario : Agendamento"] {
        horario = SLOT-FICTICIO 2040-08-17 09h00
        situacao = CONFIRMADO
    }
    class atendimentoCenario["atendimentoCenario : Atendimento"]
    class registroAuditoriaCenario["registroAuditoriaCenario : RegistroAuditoria"] {
        operacao = AGENDAMENTO_CONFIRMADO
    }

    %% Cores agrupam conceitos visualmente; nao definem novas classes.
    classDef acesso fill:#ecebff,stroke:#635dff,stroke-width:1.5px,color:#202124
    classDef cadastro fill:#e5f3f1,stroke:#008a7a,stroke-width:1.5px,color:#202124
    classDef agenda fill:#f2f3f5,stroke:#59636e,stroke-width:1.5px,color:#202124

    contaProfissionalCenario -- profissionalCenario : A03
    contaPacienteCenario -- pacienteCenario : A04
    profissionalCenario -- vinculoCenario : A06
    pacienteCenario -- vinculoCenario : A07
    profissionalCenario -- agendaCenario : A08
    agendaCenario -- disponibilidadeCenario : A09
    agendamentoCenario -- atendimentoCenario : A15
    contaProfissionalCenario -- registroAuditoriaCenario : A16

    note "OBJ-001 mostra um agendamento confirmado; OBJ-002 permanece separado para documentar estados distintos do ciclo. Fotografia parcial; contagens nao definem multiplicidades."
    note for contaProfissionalCenario "Identificacao ilustrativa, sem tipo/formato aprovado. Credencial, situacao e perfis omitidos da vista."
    note for contaPacienteCenario "Identificacao ilustrativa. Conta separada do cadastro; nao representa login ou acesso autorizado."
    note for vinculoCenario "Vinculo formalizado no cenario. Slots situacao/datas omitidos; nao se afirma resultado de estaAutorizado."
    note for agendamentoCenario "Agendamento criado no mesmo ato da confirmacao (DEC-016/DEC-017). A15 e a confirmacao do atendimento sao distintos; o agendamento pode existir sem atendimento registrado."
    note for atendimentoCenario "Atendimento registrado somente apos o agendamento valido e o contexto da sessao; nao e criado automaticamente na confirmacao."
    note for disponibilidadeCenario "Periodo ficticio, sem fixar tipo, formato, fuso, recorrencia ou duracao padrao. Nao comprova horario livre."
